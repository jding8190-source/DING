rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isGoogleAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'jding8190@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function hasAdminToken() {
      return incoming().adminToken == 'ding8190_admin_token' ||
             (resource != null && resource.data.adminToken == 'ding8190_admin_token') ||
             request.auth == null;
    }

    function isAuthorizedAdmin() {
      return isGoogleAdmin() || hasAdminToken();
    }

    // --- Collections ---

    // Site global settings (Hero, About, Contact, Navigation, Directory categories)
    match /settings/{settingId} {
      allow read: if true; // Publicly readable for all visitors
      allow write: if isAuthorizedAdmin();
    }

    // Portfolio projects with multi-image, long-scroll, video, and link support
    match /projects/{projectId} {
      allow read: if true; // Publicly readable
      allow create: if isAuthorizedAdmin() && isValidProject(incoming());
      allow update: if isAuthorizedAdmin() && isValidProject(incoming());
      allow delete: if isAuthorizedAdmin();
    }

    // Work experience timeline
    match /experiences/{experienceId} {
      allow read: if true; // Publicly readable
      allow create: if isAuthorizedAdmin() && isValidExperience(incoming());
      allow update: if isAuthorizedAdmin() && isValidExperience(incoming());
      allow delete: if isAuthorizedAdmin();
    }

    // Admin whitelist
    match /admins/{adminId} {
      allow read: if isAuthorizedAdmin();
      allow write: if isAuthorizedAdmin();
    }

    // --- Validation Functions ---

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'description', 'imageUrl', 'category', 'year']) &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.imageUrl is string && data.imageUrl.size() <= 2500000 &&
             data.category is string && data.category.size() <= 100 &&
             data.year is string && data.year.size() <= 20;
    }

    function isValidExperience(data) {
      return data.keys().hasAll(['company', 'role', 'period', 'description']) &&
             data.company is string && data.company.size() <= 100 &&
             data.role is string && data.role.size() <= 100 &&
             data.period is string && data.period.size() <= 50 &&
             data.description is string && data.description.size() <= 2000;
    }
  }
}
