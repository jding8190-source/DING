rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'jding8190@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    match /projects/{projectId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidProject(incoming());
      allow update: if isAdmin() && isValidProject(incoming());
      allow delete: if isAdmin();
    }

    match /experiences/{experienceId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidExperience(incoming());
      allow update: if isAdmin() && isValidExperience(incoming());
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Validation Functions ---

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'description', 'imageUrl', 'category', 'year']) &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.imageUrl is string && data.imageUrl.size() <= 500 &&
             data.category is string && data.category.size() <= 50 &&
             data.year is string && data.year.size() <= 10;
    }

    function isValidExperience(data) {
      return data.keys().hasAll(['company', 'role', 'period', 'description']) &&
             data.company is string && data.company.size() <= 100 &&
             data.role is string && data.role.size() <= 100 &&
             data.period is string && data.period.size() <= 50 &&
             data.description is string && data.description.size() <= 1000;
    }
  }
}
